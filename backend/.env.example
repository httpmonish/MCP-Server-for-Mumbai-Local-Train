# Project & Environment
PROJECT_NAME="मुंबईTeleport Platform"
ENVIRONMENT=development
PORT=8000

# Database & Cache Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_production
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT Configuration (Phase 1)
JWT_SECRET_KEY=change_this_to_a_secure_minimum_32_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_DEFAULT=20/minute
RATE_LIMIT_LOGIN=5/minute

# Academic Portal Scraper Credentials & Configuration
PORTAL_BASE_URL=https://mockportal.local
PORTAL_DEFAULT_USERNAME=your_student_id
PORTAL_DEFAULT_PASSWORD=your_portal_password
SCRAPER_MAX_CONCURRENCY=2

# Cache TTL Configuration (in seconds)
TTL_ATTENDANCE=3600
TTL_EXAMS=86400

# Master Encryption Key (32-byte Base64 for AES-GCM)
ENCRYPTION_MASTER_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
CHAOS_MODE_ENABLED=false
