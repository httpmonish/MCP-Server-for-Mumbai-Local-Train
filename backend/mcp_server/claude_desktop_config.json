{
  "mcpServers": {
    "campus-commute-server": {
      "command": "/absolute/path/to/mcp-data-server/venv/bin/python",
      "args": ["-m", "backend.mcp_server.server"],
      "cwd": "/absolute/path/to/mcp-data-server/backend",
      "env": {
        "PYTHONPATH": ".",
        "DATABASE_URL": "postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_data",
        "REDIS_URL": "redis://localhost:6379/0",
        "PORTAL_DEFAULT_USERNAME": "your_test_user",
        "PORTAL_DEFAULT_PASSWORD": "your_test_password"
      }
    }
  }
}
